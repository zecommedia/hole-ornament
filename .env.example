# Copy to .env and fill in. Never commit .env.

# ---- Server ----
PORT=4500
# Where job artifacts + staged uploads are written (24h TTL).
DATA_DIR=data
# Optional shared token. If set, /api/* (except health) requires header
# X-Auth-Token: <this>. Leave empty for an open local tool.
AUTH_TOKEN=
LOG_LEVEL=info

# ---- V98Store (nano-banana / Gemini image proxy, OpenAI-compatible) ----
# Used by the EXTRACT step (strip background/ribbon/hole → design+acrylic on white)
# and the vision hole-detect helper. Account has a spend cap; top up at v98store.com.
V98_API_KEY=sk-your-v98store-key-here
V98_BASE_URL=https://v98store.com/v1
V98_IMAGE_MODEL=gemini-2.5-flash-image
# Optional: vision model for hole auto-detection (gpt-4o is most consistent).
V98_VISION_MODEL=gpt-4o

# ---- RMBG (background remover) ----
# URL of the local RMBG server (see py-rmbg/). Default below matches its default port.
RMBG_URL=http://127.0.0.1:5001
# HuggingFace token (RMBG-2.0 downloads weights on first run).
HF_TOKEN=hf_your-token-here

# ---- Compositor tuning (optional) ----
# Auto inside-vs-loop threshold: top-loop band fraction above which the hole is
# placed in a loop above the shape (else drilled inside). Default 0.045.
# ORNAMENT_LOOP_BAND_THRESHOLD=0.045
